# Copy to .env for local runs (npm start) and set the same names on Vercel.
# Values are left empty on purpose (examples in comments) — never commit real keys.

# ── Sandbox key profiles (three sandbox MIDs; see utils/key-profiles.js) ──
# Access/secret pair per MID; EWALLETS is a comma-list, the first is the collection
# wallet (and the payout source wallet — it needs funds to pay out).
# Shapes: ACCESS_KEY=rak_…  SECRET_KEY=rsk_…  EWALLETS=ewallet_…[,ewallet_…]
# Leave a profile you don't use EMPTY: it then answers 500 MISSING_KEYS (and
# set-vercel-env.sh skips it) instead of signing with placeholder keys.
RAPYD_SC1_ACCESS_KEY=
RAPYD_SC1_SECRET_KEY=
RAPYD_SC1_EWALLETS=
RAPYD_SC2_ACCESS_KEY=
RAPYD_SC2_SECRET_KEY=
RAPYD_SC2_EWALLETS=
RAPYD_SC3_ACCESS_KEY=
RAPYD_SC3_SECRET_KEY=
RAPYD_SC3_EWALLETS=

# ── Legacy flat sandbox pair — used as SC1 only while RAPYD_SC1_* is unset ──
RAPYD_SANDBOX_ACCESS_KEY=
RAPYD_SANDBOX_SECRET_KEY=

# ── Live (real money). Unused unless PAYBRIDGE_LIVE_TOKEN is also set. ──
RAPYD_LIVE_ACCESS_KEY=
RAPYD_LIVE_SECRET_KEY=
# Live collection wallet(s), injected server-side into live payments (and the
# source wallet of live payouts).
RAPYD_LIVE_EWALLETS=

# Shared secret (>= 16 chars) the frontend sends as X-PayBridge-Live-Token.
# Unset (or shorter) = every live request is refused with 403 LIVE_DISABLED.
PAYBRIDGE_LIVE_TOKEN=
# Max amount for live payments / checkout sessions / refunds / payouts (default 1).
LIVE_MAX_AMOUNT=1
# Live PAYOUTS send real money out of RAPYD_LIVE_EWALLETS. Anything but `true`
# (the default: unset) refuses every live payout call with 403 LIVE_PAYOUTS_DISABLED,
# even with a valid live token. Sandbox payouts are unaffected.
LIVE_PAYOUTS_ENABLED=

# ── CORS ──
# Comma-list of frontend origins allowed to call the API (exact match, no
# trailing slash). Unset = Access-Control-Allow-Origin: * (demo default).
# Only set it once you know every origin the frontend is served from — any
# value (even a placeholder) blocks all other origins.
# e.g. ALLOWED_ORIGINS=https://paybridge.example.com,http://localhost:8000
ALLOWED_ORIGINS=

# ── Webhooks ──
# true = store only events whose Rapyd signature verified (forged/unsigned dropped).
WEBHOOK_REQUIRE_SIGNATURE=false
# Exact URL registered with Rapyd, when it differs from https://<host>/api/webhook
# (custom domain, proxy). Rapyd signs this URL.
WEBHOOK_PUBLIC_URL=

# ── KV store for webhook events (Vercel KV or Upstash — either name pair) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Local server port (server.js only; Vercel ignores it) ──
PORT=3000
